{
  "name": "gulo-gulo2",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "npm run dev --workspace @gulo/web",
    "build": "npm run build --workspace @gulo/web",
    "start": "npm run start --workspace @gulo/web",
    "lint": "npm run lint --workspace @gulo/web",
    "typecheck": "npm run typecheck --workspace @gulo/web",
    "test": "node --test \"tooling/*.test.mjs\" \"apps/web/src/**/*.test.ts\"",
    "test:browser": "playwright test",
    "check:rules": "node tooling/check-rules.mjs",
    "check": "npm run check:rules && npm run lint && npm run typecheck && npm test",
    "changes": "node tooling/changes.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "supabase": "2.121.0",
    "vercel": "64.5.0"
  }
}
