# Meny och begränsad demo kräver inga nycklar. Fri chatt kräver båda Claude-fälten.
# Hemligheter får endast läsas av serverkod.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
# Ange modell-ID som ditt Anthropic-konto har tillgång till. Ingen implicit standard.
ANTHROPIC_MODEL=
# Separat slumpmässig superadmin-kod, minst 16 tecken. Tomt låser /admin.
ADMIN_ACCESS_CODE=
# Webbplatsens adress och indexering (WEBB-014). Sätt SITE_INDEXABLE=true endast i produktion.
SITE_URL=
SITE_INDEXABLE=
# Nyhetsbrev via Brevo (WEBB-013). Tomt visar att anmälan inte är öppen ännu.
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
